# Supabase backend (Phase 1). Copy to `.env` for local development, or set as
# repo secrets/variables for the Pages build. Without these the app runs in
# local-only mode (localStorage, no sync) — nothing breaks.

# Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase dashboard → Project Settings → API → anon public key.
# Safe to ship in the client; table access is gated by row-level security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
