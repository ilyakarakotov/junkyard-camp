# Supabase backend (Phase 1). Copy to `.env` for local development, or set as
# repo secrets/variables for the Pages build. Without these the app runs in
# local-only mode (localStorage, no sync) — nothing breaks.

# Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase dashboard → Project Settings → API. Either key type works with
# supabase-js v2: the modern publishable key (sb_publishable_..., preferred —
# it rotates independently) or the legacy anon JWT (eyJhbGciOi...).
#
# Safe to ship in the client. Row-level security gates every table, and reads
# additionally require an active app_users row, so extracting this key out of
# the bundle gets you nothing without a seeded account.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
