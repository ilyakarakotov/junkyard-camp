{
  "name": "junkyard-redemption",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/validate-tokens.mjs && node scripts/check-material.mjs && node scripts/check-dod.mjs && node scripts/check-motion.mjs && node scripts/check-commit-flow.mjs",
    "verify": "npm test && npm run build && npm run check"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/oswald": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.52.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
